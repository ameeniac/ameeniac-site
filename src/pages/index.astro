---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<Base title="ameeniac — writing">
  <div class="lede">
    <p>Everything is <em>discoverable</em> if you know where to look.</p>
  </div>

  <ol class="trace">
    {
      posts.map((post) => (
        <li class="trace__item">
          <div class="trace__meta">
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            {post.data.tag && <span class="trace__tag">{post.data.tag}</span>}
          </div>
          <h2 class="trace__title">
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
          </h2>
          <p class="trace__desc">{post.data.description}</p>
        </li>
      ))
    }
  </ol>
</Base>
